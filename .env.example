# Firebase web app config: Firebase console → Project settings → Your apps → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=integrity-jx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=integrity-jx
VITE_FIREBASE_STORAGE_BUCKET=integrity-jx.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to use local emulators (npm run emulators)
VITE_USE_EMULATORS=false
